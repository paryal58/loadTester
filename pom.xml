<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven build file for the Mini Load Tester.

    Design decision: the tool has ZERO runtime dependencies. Everything
    (HTTP client, HTTP server for the demo target, JSON writing, argument
    parsing, histogram/statistics) is built on the JDK standard library
    only. This is deliberate: it keeps the tool trivially portable (no
    dependency hell, no version conflicts) and it forces the implementation
    to actually understand the primitives instead of delegating to a
    library like Apache HttpClient, picocli, or HdrHistogram.

    JUnit is included at test scope only - it never ships in the final jar.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.loadtester</groupId>
    <artifactId>mini-load-tester</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Mini Load Tester</name>
    <description>
        A from-scratch CLI load testing tool (mini JMeter/k6) supporting
        configurable concurrency, open-loop (fixed-rate) and closed-loop
        (fixed-concurrency) load models, ramp-up patterns, and
        coordinated-omission-corrected latency percentile reporting.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- Test-only dependency. Never bundled into the shipped jar. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>mini-load-tester</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!--
                Produces an executable "fat" jar. Because we have zero
                runtime dependencies, a plain jar-plugin with a manifest
                entry is enough - no shading required.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.loadtester.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
